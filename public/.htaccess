# ----------------------------------------------------------------------
# Essence Indonesia — Apache / LiteSpeed Production Configuration
# ----------------------------------------------------------------------

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS and canonical non-www domain
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  RewriteRule ^(.*)$ https://essenceindonesia.com/$1 [R=301,L]

  # 2. Pass existing files & directories directly (Instant serve for SSG & Assets)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Fallback for SPA routing if directory or file does not exist
  RewriteRule ^ index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# Proper MIME Types & Direct Access
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType image/x-icon .ico
  AddType application/manifest+json .webmanifest
  AddType text/plain .txt
</IfModule>

# ----------------------------------------------------------------------
# GZIP / Deflate Compression for Speed & SEO Score
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# Browser Caching Headers
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  
  # HTML pages & Sitemaps (short cache so updates reflect immediately)
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  
  # CSS & JavaScript (Vite handles hashed assets)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  
  # Media & Images
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
</IfModule>

# ----------------------------------------------------------------------
# Security & Crawler Headers (HSTS, Anti-Sniff, Favicon CORS)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://essenceindonesia.com; media-src 'self'; connect-src 'self' https://wa.me; frame-ancestors 'self'"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Allow Google Favicon Bot & Web Crawlers to access favicon & manifest across origins
  <FilesMatch "\.(ico|png|svg|webmanifest|xml|txt)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
